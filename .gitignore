# Unity (TestProject)
/TestProject/[Ll]ibrary/
/TestProject/[Tt]emp/
/TestProject/[Oo]bj/
/TestProject/[Bb]uild/
/TestProject/[Bb]uilds/
/TestProject/[Ll]ogs/
/TestProject/[Uu]ser[Ss]ettings/
/TestProject/MemoryCaptures/
/TestProject/.vscode/
/TestProject/.vs/
/TestProject/.idea/
/TestProject/*.csproj
/TestProject/*.sln
/TestProject/*.slnx
/TestProject/*.suo
/TestProject/*.user
/TestProject/*.pidb
/TestProject/*.booproj
/TestProject/*.svd
/TestProject/*.pdb
/TestProject/*.mdb
/TestProject/*.opendb
/TestProject/*.VC.db
/TestProject/*.unitypackage
/TestProject/*.apk
/TestProject/*.aab
/TestProject/crashlytics-build.session.json
/TestProject/sysinfo.txt

# 루트에 놓인 에디터 솔루션 파일
/*.slnx
/*.sln

# Python
.venv/
venv/
__pycache__/
*.pyc

# 오디오 (샘플 예외는 아래에서 허용)
*.mp3
*.wav
*.ogg
*.flac
!/Packages-src/**/Samples~/**/*.mp3
!/Packages-src/**/Samples~/**/*.wav
!/Packages-src/**/Samples~/**/*.ogg

# 분석 테스트용 폴더: 내용은 전부 무시, 폴더 설명만 추적
/TestAudio/*
!/TestAudio/.gitkeep
!/TestAudio/README.md

# Unity 안에서 분석을 시험하려고 넣는 테스트 오디오(.mp3 는 위에서 이미 제외되지만 .meta 와 폴더는 따로 제외)
/TestProject/Assets/TestAudio/
/TestProject/Assets/TestAudio.meta

# 샘플 제작용 작업 폴더와, Package Manager 에서 가져온 샘플 사본(원본은 Packages-src/**/Samples~)
/TestProject/Assets/SampleBuild/
/TestProject/Assets/SampleBuild.meta
/TestProject/Assets/Samples/
/TestProject/Assets/Samples.meta

# OS
.DS_Store
Thumbs.db

# 다른 MCP 패키지가 남기는 로컬 도구 설정
/TestProject/ProjectSettings/McpUnitySettings.json
